{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hakudb;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "UseKeycloak": false,
  "Keycloak": {
    "AuthServerUrl": "https://keycloak.example.com",
    "Realm": "your-realm",
    "Resource": "haku-service",
    "VerifyTokenAudience": true,
    "SslRequired": "external",
    "Credentials": {
      "Secret": "your-client-secret"
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong",
    "Issuer": "HakuService",
    "Audience": "HakuServiceAPI",
    "ExpirationMinutes": 60
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Localization": {
    "DefaultLanguage": "tr",
    "SupportedLanguages": "tr,en,ar,de,fr"
  },
  "ServiceUrls": {
    "AuthService": "http://localhost:5100",
    "NotificationService": "http://localhost:5200"
  },
  "FeatureFlags": {
    "NewDashboard": true,
    "BetaFeatures": false,
    "ShowFeaturedFirst": true,
    "PremiumFeature": {
      "Enabled": true,
      "Percentage": 50,
      "AllowedTenants": [1, 2, 3],
      "AllowedRoles": ["Admin", "Manager"]
    }
  },
  "AllowedHosts": "*"
}

