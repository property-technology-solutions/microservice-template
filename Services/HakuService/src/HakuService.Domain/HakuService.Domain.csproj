<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Local development: Use ProjectReference when BuildingBlocks exists -->
    <ItemGroup Condition="Exists('../../../../BuildingBlocks/BuildingBlocks.Domain/BuildingBlocks.Domain.csproj')">
        <ProjectReference Include="../../../../BuildingBlocks/BuildingBlocks.Domain/BuildingBlocks.Domain.csproj" />
    </ItemGroup>
    
    <!-- Template usage: Use NuGet when generated standalone -->
    <ItemGroup Condition="!Exists('../../../../BuildingBlocks/BuildingBlocks.Domain/BuildingBlocks.Domain.csproj')">
        <PackageReference Include="Enterprise.BuildingBlocks.Domain" />
    </ItemGroup>

</Project>
