<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Public NuGet -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- Enterprise BuildingBlocks Feed -->
    <add key="enterprise" value="https://nuget.pkg.github.com/propertytechnologysolutions/index.json" />
  </packageSources>
  
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="enterprise">
      <package pattern="Enterprise.BuildingBlocks.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
